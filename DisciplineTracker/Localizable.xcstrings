    },
    "The first two options use the current time. Tomorrow keeps the task's scheduled hour." : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primele două opțiuni calculează noua oră pornind de acum. Opțiunea pentru mâine păstrează ora programată a activității."
          }
        }
      }
    },
    "The notification action could not be saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
