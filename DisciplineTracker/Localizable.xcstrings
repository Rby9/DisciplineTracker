          }
        }
      }
    },
    "These figures reflect the tasks currently scheduled for this week. Skipped tasks remain in Planned, but do not count as completed or pending. Moving or deleting a task updates these figures." : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste valori reflectă activitățile programate în prezent pentru această săptămână. Activitățile omise rămân în totalul celor planificate, dar nu sunt considerate finalizate sau de făcut. Mutarea ori ștergerea unei activități actualizează aceste valori."
          }
        }
      }
    },
